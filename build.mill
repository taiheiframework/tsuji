package build

import mill.*
import mill.scalalib.*
import mill.scalalib.publish.*
import mill.scalalib.scalafmt.*
import mill.scalajslib.*

import com.github.lolgab.mill.mima.Mima
import com.goyeau.mill.scalafix.ScalafixModule

// ---------------------------------------------------------------------------
// Version catalog
// ---------------------------------------------------------------------------
object V {
  val scala         = "3.9.0"
  val scalaJS       = "1.22.0"
  val zio           = "2.1.27"
  val zioJson       = "1.1.1"
  val scalaJavaTime = "2.8.0"
}

// ---------------------------------------------------------------------------
// Version from git: an exact v-tag on a clean tree is the release, anything else
// a SNAPSHOT of the last tag. Untracked files do not count. A Task.Input, so a
// new commit, tag or edit is seen without restarting the Mill daemon. The
// release itself is the Makefile's (release-prepare / release-finalize).
// ---------------------------------------------------------------------------
object release extends Module {
  private def gitAt(root: os.Path, args: String*) = os.proc("git", args).call(cwd = root, check = false)

  // Not being at an exact tag is the normal case, so this probe's "no tag exactly matches" is kept
  // out of the log. Every other git error stays visible: a describe that fails for another reason
  // (a shallow clone, git refusing the repository) must not leave MiMa without a baseline unseen.
  private def isExactTag(root: os.Path) = os
    .proc("git", "describe", "--tags", "--exact-match", "--match", "v[0-9]*")
    .call(cwd = root, check = false, stderr = os.Pipe)
    .exitCode == 0

  def gitVersion = Task.Input {
    val root     = os.Path(sys.env("MILL_WORKSPACE_ROOT"))
    def git(args: String*) = gitAt(root, args*)
    val tag      = git("describe", "--tags", "--abbrev=0", "--match", "v[0-9]*")
    val version  = if (tag.exitCode == 0) tag.out.trim().stripPrefix("v") else "0.0.0"
    val exactTag = isExactTag(root)
    val clean    = git("status", "--porcelain").out.text().linesIterator.forall(_.startsWith("??"))
    if (exactTag && clean) version else s"$version-SNAPSHOT"
  }

  // The first release as dev.taihei::taihei-tsuji. Older tags are genius-i18n, edo-i18n and
  // taihei-i18n, other artifacts, so there is nothing of this one on Central to compare them with.
  val firstRelease = "5.0.0"

  // The first release of the major line main is on. MiMa compares only within a major line: a
  // major may break, so a release of the previous major is no baseline for it. Raise this when
  // work on the next major starts on main; release-prepare TYPE=major still sets none.
  val majorLine = "5.0.0"

  // The family's Maven repository, the one repository this build adds to Coursier's defaults
  // (Maven Central), after them. It serves the libraries' immutable GitHub Releases, so a version
  // is usable before the release train takes it to Central. The Makefile's REPO_URL holds the
  // same string, and repo-guard checks that they agree. Moving the site to another address
  // changes both lines.
  val repoUrl = "https://taiheiframework.github.io/repo/"

  // Where a version of this library's JVM module has its POM, in a Maven repository.
  private def pomAt(root: String, v: String) =
    s"${root.stripSuffix("/")}/dev/taihei/taihei-tsuji_3/$v/taihei-tsuji_3-$v.pom"

  // Whether a repository has a version: 200 yes, 404 no, anything else (a redirect included)
  // fails the build, since a baseline we cannot determine must not turn into no baseline. A file,
  // not the version's directory: the family's repository answers 404 for a directory.
  private def has(name: String, root: String, v: String): Boolean = {
    val code = os
      .proc("curl", "-q", "-s", "--proto", "=https", "--max-time", "30", "-o", "/dev/null", "-w", "%{http_code}", pomAt(root, v))
      .call(check = false)
      .out
      .trim()
    code match {
      case "200" => true
      case "404" => false
      case other => sys.error(s"cannot tell whether $v is on $name (HTTP $other): no MiMa baseline")
    }
  }

  private def released(v: String): Boolean =
    has("Maven Central", "https://repo1.maven.org/maven2", v) || has(repoUrl, repoUrl, v)

  // The release MiMa compares with: the newest v-tag reachable from HEAD, none before
  // firstRelease or majorLine, whose version must be on Maven Central or on the family's
  // repository (repoUrl); MiMa resolves it through the same two. A tag on neither fails the build,
  // naming it: a pushed tag is final and is published by release-github and publish-repo within
  // minutes, so a tag the repository does not serve is something to look at, never a reason to
  // compare with an older release unseen. Until it is served, MIMA_BASELINE names the release to
  // compare with. On a release itself (an exact v-tag on a clean tree, as in CI on the
  // tagged commit) that tag is HEAD's own, which would compare the release with itself; so there
  // the search starts at the commit before it. MIMA_BASELINE overrides it: `none` for a major,
  // which may break (release-prepare TYPE=major sets it), or a version.
  def mimaBaseline = Task.Input {
    val root = os.Path(sys.env("MILL_WORKSPACE_ROOT"))
    def git(args: String*) = gitAt(root, args*)
    def numbers(v: String) = v.split('.').toSeq.map(_.toIntOption.getOrElse(0))
    def atLeast(v: String, floor: String) = Ordering.Implicits.seqOrdering[Seq, Int].gteq(numbers(v), numbers(floor))
    Task.env.get("MIMA_BASELINE").map(_.trim).filter(_.nonEmpty) match {
      case Some("none") => None
      case Some(v)      => Some(v)
      case None         =>
        val exactTag = isExactTag(root)
        val clean    = git("status", "--porcelain").out.text().linesIterator.forall(_.startsWith("??"))
        // HEAD^ of a root commit does not exist: then there is no tag before it and no baseline.
        val from   = if (exactTag && clean) "HEAD^" else "HEAD"
        // Only a root commit has no HEAD^; any other git failure (a shallow clone, say) must not
        // pass as "no baseline".
        if (git("rev-parse", "--is-shallow-repository").out.trim() != "false")
          sys.error("a shallow clone (or git failed): fetch the full history and the tags, or set MIMA_BASELINE")
        val hasFrom = gitAt(root, "rev-parse", "-q", "--verify", s"$from^{commit}").exitCode == 0
        if (!hasFrom && from == "HEAD") sys.error("git cannot read HEAD: no MiMa baseline")
        val listed = git("tag", "--merged", from, "--list", "v[0-9]*", "--sort=-v:refname")
        if (hasFrom && listed.exitCode != 0)
          sys.error(s"git tag --merged $from failed: ${listed.err.text().trim()}")
        val candidates = listed.out
          .lines()
          .map(_.trim.stripPrefix("v"))
          .filter(_.matches("[0-9]+\\.[0-9]+\\.[0-9]+"))
          .filter(v => atLeast(v, firstRelease) && atLeast(v, majorLine))
        candidates.headOption.map { v =>
          if (!released(v))
            sys.error(
              s"v$v is neither on Maven Central nor on $repoUrl: publish it (make release-github, make publish-repo), or set MIMA_BASELINE",
            )
          v
        }
    }
  }
}

// ---------------------------------------------------------------------------
// Binary compatibility: MiMa compares the artifact with the baseline release on Central and
// fails on a break (`make mima`, part of validate). No baseline, nothing to compare.
// ---------------------------------------------------------------------------
trait TaiheiMima extends Mima with PublishModule {
  def mimaPreviousVersions = Task(release.mimaBaseline().toSeq)
  // The plugin's default fails without a version; no baseline here means nothing to compare.
  def mimaPreviousArtifacts = Task {
    mimaPreviousVersions().map(v => mvn"${pomSettings().organization}:${artifactId()}:$v")
  }
}

// ---------------------------------------------------------------------------
// Shared publishing settings for JVM and JS modules: what Maven Central
// validates (name, description, url, licence, developer, scm, sources, docs).
// ---------------------------------------------------------------------------
// The repositories a module resolves from, in order, as repo-guard reads them.
trait TaiheiResolverOrder extends CoursierModule {
  def resolverOrder: T[Seq[String]] = Task {
    repositoriesTask().map {
      case m: coursier.maven.MavenRepository => m.root
      case i: coursier.ivy.IvyRepository     => s"ivy:${i.pattern.string}"
      case other                             => other.toString
    }
  }
}

trait TaiheiPublishSettings extends PublishModule with TaiheiResolverOrder {
  def publishVersion = release.gitVersion()

  // Coursier's defaults (Maven Central), then the family's repository, and nothing else. Mill's
  // own `repositories` would put an added repository before Central, where it could stand in for
  // anything Central has; appended, it is asked only for what Central does not have. The test
  // modules use their module's repositories. repo-guard reads resolverOrder.
  override def repositoriesTask: Task[Seq[coursier.Repository]] = Task.Anon {
    coursierConfigModule().defaultRepositories() :+ coursier.maven.MavenRepository(release.repoUrl)
  }


  // What a published jar holds comes only from folders in git: no default folder under the
  // module's directory, where a stray file would go into a jar unnoticed. A module that has
  // resources names them.
  def resources        = Task.Sources()
  def compileResources = Task.Sources()
  def docResources     = Task.Sources()

  def pomSettings = PomSettings(
    description = "Type-safe i18n for Scala 3: languages, typed message families and catalogues, ICU MessageFormat 2.0 and locale-aware formatting; JVM and Scala.js",
    organization = "dev.taihei",
    url = "https://github.com/taiheiframework/tsuji",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("taiheiframework", "tsuji"),
    developers = Seq(
      Developer("innovenso", "Innovenso BV", "https://taihei.dev", Some("Innovenso BV"), Some("https://innovenso.com")),
    ),
  )
}

// Silences the deprecation of dev.taihei.tsuji.legacy, which its tests use on purpose.
val LegacyInTests = Seq("-Wconf:cat=deprecation&origin=dev\\.taihei\\.tsuji\\.legacy\\..*:s")

// ---------------------------------------------------------------------------
// Base trait for JVM modules
// ---------------------------------------------------------------------------
trait TaiheiModule extends ScalaModule with ScalafmtModule with ScalafixModule with TaiheiPublishSettings with TaiheiMima {
  def scalaVersion = V.scala

  def scalacOptions = Seq(
    "-Wunused:all",
    "-unchecked",
    "-deprecation",
    "-feature",
    "-Xmax-inlines:128",
    // The message macro expands in user code: what it calls must be public in the bytecode.
    "-WunstableInlineAccessors",
    "-Wconf:msg=Unstable inline accessor:e",
    // Java 17 is the JVM floor (Scala 3.9's too). This compiles against the Java 17 API, not the
    // API of the JDK that runs the build, so a call added in a later Java fails here, on any JDK,
    // instead of at run time on a user's Java 17.
    "-java-output-version:17",
  )

  trait TaiheiTests extends ScalaTests with ScalafmtModule with ScalafixModule with TaiheiResolverOrder {
    def testFramework = "zio.test.sbt.ZTestFramework"

    // The JDK the tests run on: the module's (Mill's own) unless TAIHEI_TEST_JAVA_HOME names
    // another. CI runs them once more on Java 17, the oldest Java the library supports. Only the
    // tests: what is compiled and published does not depend on it.
    def testJavaHome = Task.Input(Task.env.get("TAIHEI_TEST_JAVA_HOME").map(_.trim).filter(_.nonEmpty))
    def javaHome     = Task {
      testJavaHome().map(home => PathRef(os.Path(home), quick = true)).orElse(TaiheiModule.this.javaHome())
    }

    // The tests of legacy.Message use it on purpose.
    def scalacOptions = Task { super.scalacOptions() ++ LegacyInTests }

    def forkArgs = Seq(
      "-Xmx4G",
      "-Xms2G",
      "-Xss16M",
      "-XX:+UseG1GC",
      "-XX:MaxGCPauseMillis=200",
    )

    def mvnDeps = Seq(
      mvn"dev.zio::zio-test:${V.zio}",
      mvn"dev.zio::zio-test-sbt:${V.zio}",
    )
  }
}

// ---------------------------------------------------------------------------
// Base trait for Scala.js modules
// ---------------------------------------------------------------------------
trait TaiheiJSModule extends ScalaJSModule with ScalafmtModule with ScalafixModule with TaiheiPublishSettings with TaiheiMima {
  def scalaVersion   = V.scala
  def scalaJSVersion = V.scalaJS

  def scalacOptions = Seq(
    "-Wunused:all",
    "-unchecked",
    "-deprecation",
    "-feature",
    "-Xmax-inlines:128",
    // The message macro expands in user code: what it calls must be public in the bytecode.
    "-WunstableInlineAccessors",
    "-Wconf:msg=Unstable inline accessor:e",
  )

  // java.time on Scala.js is provided by scala-java-time (+ tzdb for zone data).
  def jsDeps = Seq(
    mvn"io.github.cquiroz::scala-java-time::${V.scalaJavaTime}",
    mvn"io.github.cquiroz::scala-java-time-tzdb::${V.scalaJavaTime}",
  )

  trait TaiheiJSTests extends ScalaJSTests with ScalafmtModule with ScalafixModule with TaiheiResolverOrder {
    def testFramework = "zio.test.sbt.ZTestFramework"

    // The tests of legacy.Message use it on purpose.
    def scalacOptions = Task { super.scalacOptions() ++ LegacyInTests }

    def mvnDeps = Seq(
      mvn"dev.zio::zio-test::${V.zio}",
      mvn"dev.zio::zio-test-sbt::${V.zio}",
    )
  }
}

// ---------------------------------------------------------------------------
// Workspace root for resolving cross-platform source paths
// ---------------------------------------------------------------------------
val wsRoot = os.Path(sys.env("MILL_WORKSPACE_ROOT"))

// ---------------------------------------------------------------------------
// Module: tsuji (cross-platform JVM + JS)
//   shared sources compile on both platforms; jvm/ and js/ hold the
//   platform-specific number/date formatters.
// ---------------------------------------------------------------------------
object tsuji extends Module {
  object jvm extends TaiheiModule {
    def artifactName = "taihei-tsuji"

    def sources = Task.Sources(
      wsRoot / "shared" / "src",
      wsRoot / "jvm" / "src",
    )

    def mvnDeps = Seq(
      mvn"dev.zio::zio-json:${V.zioJson}",
    )

    // The catalogue files of CoreMessages, read from the classpath. Scala.js has no classpath:
    // a browser application serves the files that taihei-tsuji-tools exports.
    def resources = Task.Sources(
      wsRoot / "shared" / "resources",
    )

    object test extends TaiheiTests {
      def sources = Task.Sources(
        wsRoot / "shared" / "test" / "src",
        wsRoot / "jvm" / "test" / "src",
      )

      def resources = Task.Sources(
        wsRoot / "jvm" / "test" / "resources",
      )
    }
  }

  object js extends TaiheiJSModule {
    def artifactName = "taihei-tsuji"

    def sources = Task.Sources(
      wsRoot / "shared" / "src",
      wsRoot / "js" / "src",
    )

    def mvnDeps = Seq(
      mvn"dev.zio::zio-json::${V.zioJson}",
    ) ++ jsDeps

    object test extends TaiheiJSTests {
      def sources = Task.Sources(
        wsRoot / "shared" / "test" / "src",
        wsRoot / "js" / "test" / "src",
      )
    }
  }

  // ---------------------------------------------------------------------------
  // taihei-tsuji-tools: the JVM-only program that exports catalogues. JVM only because its whole
  // job is writing files.
  // ---------------------------------------------------------------------------
  object tools extends TaiheiModule {
    def artifactName = "taihei-tsuji-tools"

    def pomSettings = Task {
      super.pomSettings().copy(description = "Exports the message catalogues of taihei-tsuji families to per-language JSON files; JVM")
    }

    def moduleDeps = Seq(tsuji.jvm)

    def sources = Task.Sources(
      wsRoot / "tools" / "src",
    )

    object test extends TaiheiTests {
      def sources = Task.Sources(
        wsRoot / "tools" / "test" / "src",
      )
    }
  }
}
